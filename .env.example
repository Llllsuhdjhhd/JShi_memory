# ---- LLM（OpenAI 兼容；默认 DeepSeek） ----
REMS_LLM__API_KEY=sk-your-deepseek-api-key
REMS_LLM__BASE_URL=https://api.deepseek.com

# ---- Model mapping (task -> model name) ----
# REMS_LLM__TASK_MODELS__DEFAULT=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__SUMMARY=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__BOUNDARY_DETECTION=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__EVENT_ENRICHMENT=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__ROLE_EXTRACTION=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__ABSTRACTION=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__INSIGHT=deepseek-v4-flash

# ---- Embedding ----
REMS_EMBEDDING__PROVIDER=local
REMS_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5

# ---- Storage ----
REMS_STORAGE__DATABASE_URL=sqlite:///rems.db
REMS_STORAGE__CHROMADB_PATH=./chroma_data

# ---- Context window ----
REMS_CONTEXT_WINDOW=32768
REMS_CHARS_PER_TOKEN=1.5

# ---- Recall: role-aware summary tier selection ----
# 默认召回摘要档位（0=中间级，负数=更精细，正数=更压缩）
# REMS_RECALL_DEFAULT_TIER_OFFSET=0
# 主角（S/A）在默认档位上向 L1 方向再偏移的档数
# REMS_RECALL_PRIMARY_ROLE_DETAIL_SHIFT=1
# 配角/无关角色在默认档位上向高压缩方向偏移的档数
# REMS_RECALL_MINOR_ROLE_COMPRESS_SHIFT=1
# 摘要最低字数门槛（低于此值则不再压缩）
# REMS_RECALL_SUMMARY_MIN_CHARS=20

# ---- Affective Energy (AE) ----
# REMS_AE_HIGH_THRESHOLD=0.6
# REMS_AE_SCORE_WEIGHT=0.15

# ---- White-painting forgetting ----
# REMS_WP_HALF_LIFE_DAYS=60.0
# REMS_AE_FORGETTING_MULTIPLIER=5.0

# ---- Hallucination control (abstraction anchor probability) ----
# REMS_HALLUCINATION_ANCHOR_PROB=0.3

# ---- Semantic card ----
# REMS_SEMANTIC_CARD_MAX_KEYS=20

# ---- Global user-mode (pronoun resolution, 白皮书 2.2) ----
# single | multi
# REMS_USER_MODE=single
# 单人模式下的核心用户 role_id（可留空，启动后由首轮抽取新建再回填）
# REMS_CORE_USER_ROLE_ID=
# 多人模式下的已知活跃参与者（逗号分隔；pydantic-settings 解析为 list[str]）
# REMS_ACTIVE_PARTICIPANTS=["Alice","Bob"]

# ---- Emotion: EMA dynamic evolution (白皮书 2.5) ----
# REMS_EMA_SMOOTHING_ALPHA=0.4
# REMS_EMA_HISTORY_WINDOW=10
# REMS_ACTIVATION_ENERGY_GAIN=1.0
# REMS_ACTIVATION_ENERGY_WEIGHT=0.10

# ---- White-painting collection tier (白皮书 2.3 动态粒度路由·收集端) ----
# 主角/单人模式核心用户 → L3；常规 → L2；可选 l1_mention/l2_interaction/l3_decision
# REMS_WP_PRIMARY_FIELD=l3_decision
# REMS_WP_DEFAULT_FIELD=l2_interaction
# REMS_WP_MINOR_FIELD=l2_interaction

# ---- Abstraction §3.2 narrative coherence gate (related rate **a**) ----
# REMS_ABSTRACT_NARRATIVE_COHERENCE_ENABLED=true
# REMS_ABSTRACT_NARRATIVE_COHERENCE_MIN_COUNT=3

# ---- Recall quality: relevance audit (**b**) + dynamic semantic distance ----
# REMS_RECALL_RELEVANCE_AUDIT_EVERY_N_INGESTS=10
# Weight applied to coherence **a** in EMA blend (small default → **b** dominates once sampled)
# REMS_RECALL_QUALITY_WEIGHT_COHERENCE_VS_RELEVANCE=0.1
# REMS_RECALL_QUALITY_EMA_ALPHA=0.25

# REMS_RECALL_DYNAMIC_DISTANCE_ENABLED=false
# REMS_RECALL_DYNAMIC_DISTANCE_CAP_BASE=2.0
# REMS_RECALL_DYNAMIC_DISTANCE_CAP_FLOOR=0.45
# REMS_RECALL_DYNAMIC_DISTANCE_CAP_CEILING=2.0
# REMS_RECALL_DYNAMIC_DISTANCE_SENSITIVITY=0.08
# REMS_RECALL_DYNAMIC_DISTANCE_HIT_PERCENTILE=
# 双流 A+B 向量 distance 合并样本的 P 分位（0–100），经 floor/ceiling 后与 EMA semantic_cap 取 min；留空=关闭

# REMS_LLM__TASK_MODELS__NARRATIVE_COHERENCE=deepseek-v4-flash
# REMS_LLM__TASK_MODELS__RECALL_BLOCK_RELEVANCE=deepseek-v4-flash

